@model number_sequence.Pages.UI.Chiro.ChiroCheckboxGroup
@{
  string idPrefix = Model.Name.ToLowerInvariant();
}

<div class="mb-3">
  <div class="form-label fw-semibold">@Model.Label</div>
  @for (int i = 0; i < Model.Choices.Length; i++)
  {
    string choice = Model.Choices[i];
    string id = $"{idPrefix}-{i}";
    <div class="form-check">
      <input class="form-check-input" type="checkbox" id="@id" name="@Model.Name" value="@choice" checked="@(Model.Selected?.Contains(choice) == true)" />
      <label class="form-check-label" for="@id">@choice</label>
    </div>
  }
</div>
