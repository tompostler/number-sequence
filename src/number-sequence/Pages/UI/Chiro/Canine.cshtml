@page "/ui/chiro/canine"
@using number_sequence.Pages.UI.Chiro
@model number_sequence.Pages.UI.Chiro.CanineModel
@{
  ViewData["Title"] = "Chiro - Canine";
}

@* The form itself is shared with feline, which is the same form. Anything that is not the species belongs in
   _ChiroSmallAnimalForm so the two cannot drift. *@
@await Html.PartialAsync("_ChiroFormHeader", new ChiroFormHeader { Species = "Canine" })
@await Html.PartialAsync("_ChiroSmallAnimalForm", Model)
