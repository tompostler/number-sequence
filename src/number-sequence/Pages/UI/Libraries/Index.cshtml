@page "/ui/library"
@model number_sequence.Pages.UI.Libraries.IndexModel
@{
  ViewData["Title"] = "Library";
  List<Library> editable = Model.Libraries.Where(x => x.CallerPermission >= LibraryPermission.Editor).ToList();
}

<h2 class="mb-3">Library</h2>

<partial name="_LibraryFlash" model="Model" />

<form method="get" class="mb-3">
  <div class="input-group input-group-lg">
    <input id="q" name="q" value="@Model.Q" class="form-control" placeholder="Title, author or series" autocomplete="off" inputmode="search" enterkeyhint="search" autofocus="@(Model.Q == null)" />
    <button type="button" class="btn btn-outline-secondary" data-library-scan="#q" data-library-scan-quiet hidden>Scan</button>
    <button type="submit" class="btn btn-primary">Search</button>
  </div>
  <div class="form-text">Searches every library you can see by title, author, series or notes. Scanning a copy's barcode finds that exact copy.</div>
</form>

@if (!string.IsNullOrWhiteSpace(Model.Q))
{
  <div class="mb-4">
    @if (Model.Results.Count == 0)
    {
      <div class="alert alert-secondary">
        @if (Model.QueryBarcode != null)
        {
          <div class="fw-semibold">No copy has barcode @Model.QueryBarcode.</div>
          <div class="small">Try the title: another edition, or a copy added without its barcode, won't match this code.</div>
          @foreach (Library library in editable)
          {
            <a href="/ui/library/@library.Id/items/create?barcode=@Uri.EscapeDataString(Model.QueryBarcode)" class="btn btn-sm btn-outline-primary mt-2 me-1">Add to @library.Name</a>
          }
        }
        else
        {
          <span>Nothing matches “@Model.Q”.</span>
        }
      </div>
    }
    else
    {
      <div class="text-muted small mb-1">@Model.Results.Count match@(Model.Results.Count == 1 ? "" : "es")@(Model.AnyResultsTruncated ? "; showing the first few per library, open a library to see more" : "")</div>
      <div class="list-group">
        @foreach (ItemCard card in Model.Results)
        {
          <partial name="_ItemCard" model="card" />
        }
      </div>
    }
  </div>
}

<h5 class="mt-4">Your libraries</h5>
@if (Model.Libraries.Count == 0)
{
  <p class="text-muted">No libraries yet. Create one below, or ask someone to share theirs with you.</p>
}
else
{
  <div class="list-group mb-3">
    @foreach (Library library in Model.Libraries)
    {
      <a href="/ui/library/@library.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
        <div>
          <div class="fw-semibold">@library.Name</div>
          @if (!string.IsNullOrWhiteSpace(library.Description))
          {
            <div class="small text-muted">@library.Description</div>
          }
          @if (library.CallerPermission != LibraryPermission.Owner)
          {
            <div class="small text-muted">Shared by @library.AccountName</div>
          }
        </div>
        @if (library.CallerPermission != LibraryPermission.Owner)
        {
          <span class="badge text-bg-info">@library.CallerPermission</span>
        }
      </a>
    }
  </div>
}

<details class="mb-4" open="@(Model.Libraries.Count == 0)">
  <summary class="mb-2">New library</summary>
  <form method="post" asp-page-handler="Create" class="col-12 col-md-6">
    <div class="mb-2">
      <label asp-for="NewLibrary.Name" class="form-label">Name</label>
      <input asp-for="NewLibrary.Name" value="" class="form-control" placeholder="e.g. Home, Cabin" required />
    </div>
    <div class="mb-2">
      <label asp-for="NewLibrary.Description" class="form-label">Description</label>
      <input asp-for="NewLibrary.Description" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
  </form>
</details>

<partial name="_LibraryScanner" />
