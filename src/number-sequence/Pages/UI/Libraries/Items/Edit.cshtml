@page "/ui/library/{libraryId:long}/items/{itemId:long}/edit"
@model number_sequence.Pages.UI.Libraries.Items.EditModel
@{
  ViewData["Title"] = $"Edit {Model.Item.Title}";
}

<div class="d-flex align-items-center gap-2 mb-3">
  <a href="/ui/library/@Model.Library.Id/items/@Model.Item.Id" class="btn btn-sm btn-outline-secondary">&larr;</a>
  <h2 class="mb-0 text-truncate">Edit item</h2>
</div>

<partial name="_LibraryFlash" model="Model" />

<form method="post" class="col-12 col-md-8 col-lg-6">
  <partial name="_ItemFields" for="Item" />
  <p class="form-text">Format, barcode, edition and acquisition details belong to each copy; edit those from the copy.</p>
  <div class="d-flex gap-2 mb-4">
    <button type="submit" class="btn btn-primary">Save</button>
    <a href="/ui/library/@Model.Library.Id/items/@Model.Item.Id" class="btn btn-outline-secondary">Cancel</a>
  </div>
</form>

@if (Model.Item.HasCover)
{
  @* Covers come only from the lookup pick when an item is added; removing a wrong one is the only change after that. *@
  <div class="col-12 col-md-8 col-lg-6 border rounded p-2 mb-4">
    <h6>Cover</h6>
    <div class="d-flex gap-3 align-items-start">
      <img src="@LibraryDisplay.CoverUrl(Model.Item)" alt="Cover" class="rounded border flex-shrink-0" style="width: 96px" />
      <div class="flex-grow-1">
        <div class="form-text mb-2">From the lookup it was added from. Remove it if it's the wrong one.</div>
        <form method="post" asp-page-handler="RemoveCover" data-confirm="Remove the cover of @Model.Item.Title?" onsubmit="return confirm(this.dataset.confirm)">
          <button type="submit" class="btn btn-sm btn-outline-danger">Remove cover</button>
        </form>
      </div>
    </div>
  </div>
}
