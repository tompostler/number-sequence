@page "/ui/library/{libraryId:long}/edit"
@model number_sequence.Pages.UI.Libraries.EditModel
@{
  ViewData["Title"] = $"{Model.Library.Name} settings";
}

<div class="d-flex align-items-center gap-2 mb-3">
  <a href="/ui/library/@Model.Library.Id" class="btn btn-sm btn-outline-secondary">&larr;</a>
  <h2 class="mb-0 text-truncate">Settings</h2>
</div>

<partial name="_LibraryFlash" model="Model" />

<form method="post" class="col-12 col-md-6 mb-5">
  <div class="mb-2">
    <label asp-for="Name" class="form-label">Name</label>
    <input asp-for="Name" class="form-control" maxlength="64" required />
  </div>
  <div class="mb-3">
    <label asp-for="Description" class="form-label">Description</label>
    <input asp-for="Description" class="form-control" maxlength="256" />
  </div>
  <div class="d-flex gap-2">
    <button type="submit" class="btn btn-primary">Save</button>
    <a href="/ui/library/@Model.Library.Id" class="btn btn-outline-secondary">Cancel</a>
  </div>
</form>

<div class="border border-danger rounded p-3 col-12 col-md-6">
  <h6 class="text-danger">Delete library</h6>
  <p class="small mb-2">Deletes every item, copy, loan, location, history entry and share in it. This can't be undone.</p>
  <form method="post" asp-page-handler="Delete" data-confirm="Delete @Model.Library.Name and everything in it? This can't be undone." onsubmit="return confirm(this.dataset.confirm)">
    <button type="submit" class="btn btn-sm btn-danger">Delete @Model.Library.Name</button>
  </form>
</div>
