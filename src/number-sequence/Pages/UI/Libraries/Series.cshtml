@page "/ui/library/{libraryId:long}/series"
@model number_sequence.Pages.UI.Libraries.SeriesModel
@{
  ViewData["Title"] = $"{Model.Library.Name} series";
  string here = $"/ui/library/{Model.Library.Id}/series";
}

<div class="d-flex align-items-center gap-2 mb-1">
  <a href="/ui/library/@Model.Library.Id" class="btn btn-sm btn-outline-secondary">&larr;</a>
  <h2 class="mb-0 text-truncate">Set a series</h2>
</div>
<p class="small text-muted mb-3">Find the books, tick them, and name the series once. Each book keeps its own number.</p>

<partial name="_LibraryFlash" model="Model" />

<form method="get" class="mb-3">
  <div class="input-group">
    <input asp-for="Q" name="q" class="form-control" placeholder="Author, title, or the series as it's spelled now" autocomplete="off" inputmode="search" enterkeyhint="search" />
    <button type="submit" class="btn btn-primary">Find</button>
  </div>
</form>

@if (string.IsNullOrWhiteSpace(Model.Q))
{
  @if (Model.SeriesNames.Count == 0)
  {
    <p class="text-muted">No series in this library yet. Search for an author to start one.</p>
  }
  else
  {
    <div class="small text-muted mb-1">Series in this library, to fix one's spelling or numbers:</div>
    <div class="d-flex flex-wrap gap-1 mb-4">
      @foreach (string name in Model.SeriesNames)
      {
        <a href="@here?q=@Uri.EscapeDataString(name)" class="badge text-bg-light border text-decoration-none">@name</a>
      }
    </div>
  }
}
else if (Model.Items.Count == 0)
{
  <p class="text-muted">Nothing matches.</p>
}
else
{
  <form method="post">
    <input type="hidden" name="q" value="@Model.Q" />

    <div class="mb-2">
      <label asp-for="Series" class="form-label">Series</label>
      <input asp-for="Series" class="form-control" maxlength="128" list="library-series-names" autocomplete="off" />
      <div class="form-text">Used exactly as typed. Leave blank to take the ticked books out of any series.</div>
      @if (Model.SeriesNames.Count > 0)
      {
        <datalist id="library-series-names">
          @foreach (string name in Model.SeriesNames)
          {
            <option value="@name"></option>
          }
        </datalist>
      }
    </div>

    <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
      <button type="button" class="btn btn-sm btn-outline-secondary" id="series-number-in-order">Number ticked 1, 2, 3…</button>
      <button type="button" class="btn btn-sm btn-outline-secondary" id="series-tick-none">Untick all</button>
      <span class="small text-muted">Listed by number, then year.</span>
    </div>

    <div class="list-group mb-3">
      @foreach (LibraryItem item in Model.Items)
      {
        string id = $"series-take-{item.Id}";
        <div class="list-group-item py-2" data-series-row>
          <div class="d-flex gap-2 align-items-start">
            <input type="checkbox" name="Take" value="@item.Id" id="@id" class="form-check-input mt-1 flex-shrink-0" checked="@Model.IsTicked(item)" />
            <label for="@id" class="flex-grow-1" style="min-width: 0">
              <span class="fw-semibold">@item.Title</span>
              @if (!string.IsNullOrWhiteSpace(item.Subtitle))
              {
                <span class="text-muted">: @item.Subtitle</span>
              }
              <span class="d-block small text-muted text-truncate">@LibraryDisplay.Byline(item)</span>
            </label>
            <input name="Number[@item.Id]" value="@Model.NumberFor(item)" type="number" step="any" min="0" inputmode="decimal" class="form-control form-control-sm flex-shrink-0" style="width: 5.5em" aria-label="Number in series for @item.Title" placeholder="#" />
          </div>
        </div>
      }
    </div>
    @if (Model.Truncated)
    {
      <p class="small text-muted">Only the first @Model.Items.Count matches are shown; search more narrowly for the rest.</p>
    }

    <div class="d-flex gap-2 mb-4">
      <button type="submit" class="btn btn-primary">Set series on ticked</button>
      <a href="/ui/library/@Model.Library.Id" class="btn btn-outline-secondary">Cancel</a>
    </div>
  </form>

  <script>
    // Numbers the ticked rows in the order shown, which is by number then year: right for a series with no numbers
    // saved, as long as its years are publication order.
    document.getElementById('series-number-in-order').addEventListener('click', () => {
      let n = 1;
      document.querySelectorAll('[data-series-row]').forEach(row => {
        if (row.querySelector('input[type=checkbox]').checked) {
          row.querySelector('input[type=number]').value = n++;
        }
      });
    });
    document.getElementById('series-tick-none').addEventListener('click', () => {
      document.querySelectorAll('[data-series-row] input[type=checkbox]').forEach(x => x.checked = false);
    });
  </script>
}
