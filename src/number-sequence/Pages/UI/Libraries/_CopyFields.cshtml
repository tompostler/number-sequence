@model LibraryCopy
@* Rendered with <partial for="..."> so the field names carry the page's property prefix. The page sets
   ViewData["MediaType"] for the format suggestions. Location and status are not here: they change through their own
   actions, which record history. The barcode's Scan button needs <partial name="_LibraryScanner" /> on the page. *@
@{
  string[] formats = LibraryDisplay.FormatSuggestions(ViewData["MediaType"] as LibraryMediaType?);
  string formatsId = $"formats-{ViewData.TemplateInfo.HtmlFieldPrefix}";
  string barcodeSelector = $"#{Html.IdFor(m => m.Barcode)}";
}

<div class="row g-2 mb-2">
  <div class="col-6">
    <label asp-for="Format" class="form-label">Format</label>
    <input asp-for="Format" class="form-control" maxlength="32" list="@formatsId" autocomplete="off" />
    <datalist id="@formatsId">
      @foreach (string format in formats)
      {
        <option value="@format"></option>
      }
    </datalist>
  </div>
  <div class="col-6">
    <div class="d-flex justify-content-between align-items-baseline">
      <label asp-for="AcquiredDate" class="form-label">Acquired</label>
      <button type="button" class="btn btn-link btn-sm p-0 small" onclick="this.closest('div.col-6').querySelector('input').valueAsDate = new Date(Date.now() - new Date().getTimezoneOffset() * 60000)">Today</button>
    </div>
    <input asp-for="AcquiredDate" type="date" class="form-control" />
  </div>
</div>
<div class="form-text mb-2 mt-n1">Leave Acquired blank if you don't know. It places the copy in history.</div>
<div class="mb-2">
  <label asp-for="Barcode" class="form-label">Barcode</label>
  <div class="input-group">
    <input asp-for="Barcode" class="form-control" maxlength="32" autocomplete="off" autocapitalize="characters" placeholder="Optional" />
    <button type="button" class="btn btn-outline-secondary" data-library-scan="@barcodeSelector" data-library-scan-fill hidden>Scan</button>
  </div>
  <span asp-validation-for="Barcode" class="text-danger small"></span>
  <div class="form-text">The code printed on this copy. Scanning it later finds this copy.</div>
</div>
<div class="mb-2">
  <label asp-for="Notes" class="form-label">Copy notes</label>
  <textarea asp-for="Notes" class="form-control" rows="2" maxlength="1024" placeholder="Signed, inscription, missing pieces"></textarea>
</div>
