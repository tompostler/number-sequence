@page "/ui/pdf-status"
@model number_sequence.Pages.UI.PdfStatus.IndexModel
@{
  ViewData["Title"] = "PDF Status";
}

<script>
  if (!new URLSearchParams(window.location.search).has('HoursOffset')) {
    var offset = -new Date().getTimezoneOffset() / 60;
    var url = new URL(window.location);
    url.searchParams.set('HoursOffset', offset);
    window.location.replace(url);
  }
</script>

<div class="d-flex align-items-center gap-3 mb-4">
  <h2 class="mb-0">PDF Status</h2>
  <form method="get" class="d-flex align-items-center gap-2">
    <label for="HoursOffset" class="form-label mb-0">UTC offset</label>
    <input id="HoursOffset" name="HoursOffset" type="number" step="0.5" value="@Model.HoursOffset" class="form-control form-control-sm" style="width:6rem" />
    <label for="TakeAmount" class="form-label mb-0">Take</label>
    <input id="TakeAmount" name="TakeAmount" type="number" step="1" min="1" value="@Model.TakeAmount" class="form-control form-control-sm" style="width:6rem" />
    <label for="DaysLookback" class="form-label mb-0">Days lookback</label>
    <input id="DaysLookback" name="DaysLookback" type="number" step="1" min="1" value="@Model.DaysLookback" class="form-control form-control-sm" style="width:6rem" />
    <button type="submit" class="btn btn-sm btn-outline-secondary">Apply</button>
  </form>
</div>

@if (Model.ShowChiro)
{
  <h5>Chiro Records</h5>
  @if (Model.Status.ChiroRecords.Count == 0)
  {
    <p class="text-muted">None.</p>
  }
  else
  {
    <div class="table-responsive mb-4">
      <table class="table table-striped table-sm mb-0">
        <thead>
          <tr>
            <th class="text-nowrap">ID</th>
            <th class="text-nowrap">Account</th>
            <th class="text-nowrap">Recorded</th>
            <th class="text-nowrap">Processed</th>
            <th class="text-nowrap" title="Form opened to submitted">Entry</th>
            <th class="text-nowrap" title="Dictation parsed to submitted">Review</th>
            <th class="text-nowrap" title="Submitted to pdf generated">Delay</th>
            <th class="text-nowrap">Attempt</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var record in Model.Status.ChiroRecords)
          {
            <tr>
              <td>@record.Id</td>
              <td class="text-nowrap">@record.AccountName</td>
              <td class="text-nowrap">@record.RecordedAt</td>
              <td class="text-nowrap">
                @if (record.ProcessedAt == null)
                {
                  <span class="badge bg-warning text-dark">Pending</span>
                }
                else
                {
                  @record.ProcessedAt
                }
              </td>
              @* The start and parse times are the recorded time less these, so they're hover text rather than two more
                 timestamp columns that would push the table past the container. *@
              <td class="text-nowrap" title="Opened @record.DataEnteredAt">@record.EntryTime</td>
              <td class="text-nowrap" title="@(record.DictationParsedAt == null ? null : $"Parsed {record.DictationParsedAt}")">@record.ReviewTime</td>
              <td class="text-nowrap">@record.Delay</td>
              <td class="text-nowrap">@record.ProcessAttempt</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }

  <h5>Chiro Records Pending</h5>
  @if (Model.Status.ChiroRecordsPending.Count == 0)
  {
    <p class="text-muted">None.</p>
  }
  else
  {
    <div class="table-responsive mb-4">
      <table class="table table-striped table-sm mb-0">
        <thead>
          <tr>
            <th class="text-nowrap">ID</th>
            <th class="text-nowrap">Account</th>
            <th class="text-nowrap">Data entered</th>
            <th class="text-nowrap">Recorded</th>
            <th class="text-nowrap">Delay</th>
            <th class="text-nowrap">Attempt</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var record in Model.Status.ChiroRecordsPending)
          {
            <tr>
              <td>@record.Id</td>
              <td class="text-nowrap">@record.AccountName</td>
              <td class="text-nowrap">@record.DataEnteredAt</td>
              <td class="text-nowrap">@record.RecordedAt</td>
              <td class="text-nowrap">@record.Delay</td>
              <td class="text-nowrap">@record.ProcessAttempt</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }

  <h5>Chiro Email Documents</h5>
  <partial name="_EmailDocumentTable" model="Model.Status.ChiroEmailDocuments" />

  <h5>Chiro Batches</h5>
  @if (Model.Status.ChiroBatches.Count == 0)
  {
    <p class="text-muted">None.</p>
  }
  else
  {
    <div class="table-responsive mb-4">
      <table class="table table-striped table-sm mb-0">
        <thead>
          <tr>
            <th class="text-nowrap">ID</th>
            <th class="text-nowrap">Account</th>
            <th class="text-nowrap">Recipient</th>
            <th class="text-nowrap">Attachment</th>
            <th class="text-nowrap">Size</th>
            <th class="text-nowrap">Created</th>
            <th class="text-nowrap">Processed</th>
            <th class="text-nowrap">Delay</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var batch in Model.Status.ChiroBatches)
          {
            <tr>
              <td>@batch.Id</td>
              <td class="text-nowrap">@batch.AccountName</td>
              <td class="text-nowrap">@batch.Recipient</td>
              <td>@batch.AttachmentName</td>
              <td class="text-nowrap">@batch.FileLength</td>
              <td class="text-nowrap">@batch.CreatedDate</td>
              <td class="text-nowrap">
                @if (batch.ProcessedAt == null)
                {
                  <span class="badge bg-warning text-dark">Pending</span>
                }
                else
                {
                  @batch.ProcessedAt
                }
              </td>
              <td class="text-nowrap">@batch.Delay</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }

  <h5>Chiro Batch Pending Counts</h5>
  @if (Model.Status.ChiroBatchPendingCounts.Count == 0)
  {
    <p class="text-muted">None.</p>
  }
  else
  {
    <div class="table-responsive mb-4">
      <table class="table table-striped table-sm mb-0">
        <thead>
          <tr>
            <th class="text-nowrap">Recipient</th>
            <th class="text-nowrap">Pending</th>
            <th class="text-nowrap">Size</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var count in Model.Status.ChiroBatchPendingCounts)
          {
            <tr>
              <td class="text-nowrap">@count.Recipient</td>
              <td class="text-nowrap">@count.Count</td>
              <td class="text-nowrap">@count.TotalFileLength</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }

  <h5>Chiro Forms Per Clinic</h5>
  <div class="mb-4">
    <img src="/ui/pdf-status/chart?daysLookback=@Model.DaysLookback&hoursOffset=@Model.HoursOffset&groupBy=Clinic" class="img-fluid" alt="Chiro forms per clinic chart" />
  </div>

  <h5>Chiro Forms Per Account</h5>
  <div class="mb-4">
    <img src="/ui/pdf-status/chart?daysLookback=@Model.DaysLookback&hoursOffset=@Model.HoursOffset&groupBy=Account" class="img-fluid" alt="Chiro forms per account chart" />
  </div>
}

@if (Model.ShowLedger)
{
    <h5>Ledger Email Documents</h5>
    <partial name="_EmailDocumentTable" model="Model.Status.LedgerEmailDocuments" />
}

@* Only a creation site that forgot to set EmailDocument.Kind produces these, so the section only appears when one has. *@
@if (Model.ShowUnclassified)
{
    <h5>Unclassified Email Documents</h5>
    <partial name="_EmailDocumentTable" model="Model.Status.UnclassifiedEmailDocuments" />
}
